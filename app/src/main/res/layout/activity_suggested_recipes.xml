<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pantry_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suggested recipes"
                android:textColor="@color/pantry_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Made with what you already have."
                android:textColor="@color/pantry_secondary"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓  All ingredients &amp; quantities checked."
                android:textColor="@color/pantry_pink"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/input_background"
                android:backgroundTint="@color/pantry_light_pink"
                android:padding="14dp"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:id="@+id/recipesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNoRecipes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No recipes match your pantry yet.\nAdd more ingredients to see suggestions."
                    android:textAlignment="center"
                    android:textColor="@color/pantry_secondary"
                    android:textSize="15sp"
                    android:padding="32dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/pantry_card">

        <TextView
            android:id="@+id/navPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣&#10;Pantry"
            android:textAlignment="center"
            android:textColor="@color/pantry_secondary" />

        <TextView
            android:id="@+id/navRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♨&#10;Recipes"
            android:textAlignment="center"
            android:textColor="@color/pantry_pink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙&#10;Settings"
            android:textAlignment="center"
            android:textColor="@color/pantry_secondary" />

    </LinearLayout>

</LinearLayout>