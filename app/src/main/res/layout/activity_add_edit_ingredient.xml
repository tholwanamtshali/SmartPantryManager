<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Top heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/pantry_dark"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add ingredient"
                android:textColor="@color/pantry_dark"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Ingredient name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredient name"
            android:textColor="@color/pantry_dark"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/etIngredientName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tomatoes"
            android:inputType="textCapWords"
            android:textColor="@color/pantry_dark"
            android:textColorHint="@color/pantry_secondary"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Quantity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textColor="@color/pantry_dark"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="4"
            android:inputType="numberDecimal"
            android:textColor="@color/pantry_dark"
            android:textColorHint="@color/pantry_secondary"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Unit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unit"
            android:textColor="@color/pantry_dark"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="7dp" />

        <Spinner
            android:id="@+id/spUnit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:entries="@array/unit_options"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Expiry date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiry date (optional)"
            android:textColor="@color/pantry_dark"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/etExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="04 Oct 2026"
            android:focusable="false"
            android:clickable="true"
            android:textColor="@color/pantry_dark"
            android:textColorHint="@color/pantry_secondary"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="28dp" />

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/pantry_pink"
            android:layout_marginBottom="12dp" />

        <!-- Cancel -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/pantry_pink"
            android:backgroundTint="@color/pantry_background" />

    </LinearLayout>

</ScrollView>