<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pantry_background">

    <!-- Header (static, above the list) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My pantry"
            android:textColor="@color/pantry_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good food starts here."
            android:textColor="@color/pantry_secondary"
            android:textSize="15sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:gravity="center"
            android:text="🌿  Use what\nyou have."
            android:textColor="@color/pantry_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/input_background"
            android:backgroundTint="@color/pantry_light_pink"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Search ingredients"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/pantry_dark"
            android:textColorHint="@color/pantry_secondary"
            android:background="@drawable/input_background"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

    <!-- RecyclerView takes the remaining vertical space and scrolls itself -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Empty state message (shown only when list is empty) -->
    <TextView
        android:id="@+id/tvEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No ingredients yet.\nTap Add ingredient to get started."
        android:textAlignment="center"
        android:textColor="@color/pantry_secondary"
        android:textSize="15sp"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- Add button, fixed at bottom above nav -->
    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+  Add ingredient"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/pantry_pink"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/pantry_card"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/navPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣&#10;Pantry"
            android:textAlignment="center"
            android:textColor="@color/pantry_pink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♨&#10;Recipes"
            android:textAlignment="center"
            android:textColor="@color/pantry_secondary" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙&#10;Settings"
            android:textAlignment="center"
            android:textColor="@color/pantry_secondary" />

    </LinearLayout>

</LinearLayout>